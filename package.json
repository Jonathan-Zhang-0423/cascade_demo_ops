{
  "name": "cascade-demoops-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:backend": "cd backend && go run .",
    "dev:bridge": "cd backend && go run ./cmd/devserver",
    "build:backend": "cd backend && go build ./...",
    "test:backend": "cd backend && go test ./...",
    "dev:worker": "pnpm --filter @cascade/video-worker dev",
    "build:worker": "pnpm --filter @cascade/video-worker build",
    "test:worker": "pnpm --filter @cascade/video-worker test",
    "dev:web": "pnpm --filter @cascade/web dev",
    "dev:local:editor": "powershell -ExecutionPolicy Bypass -File scripts/start-local-editor.ps1",
    "stop:local:editor": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-editor.ps1",
    "build:web": "pnpm --filter @cascade/web build",
    "test:web": "pnpm --filter @cascade/web test",
    "verify": "node scripts/verify-local.mjs",
    "validate:server-render": "node scripts/validate-server-render.mjs",
    "smoke:validate-server-render": "node scripts/smoke-validate-server-render.mjs",
    "build:desktop:win": "node scripts/build-desktop.mjs windows",
    "build:desktop:mac": "node scripts/build-desktop.mjs darwin",
    "package:desktop": "node scripts/package-desktop.mjs",
    "smoke:desktop-package": "node scripts/smoke-desktop-package.mjs",
    "package:desktop:installer": "node scripts/package-desktop-installer.mjs",
    "smoke:desktop-installer": "node scripts/smoke-desktop-installer.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
