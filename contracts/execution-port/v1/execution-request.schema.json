{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-demoops.local/contracts/execution-port/v1/execution-request.schema.json",
  "title": "DemoOps Execution Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "idempotency_key",
    "workflow_id",
    "workflow_template_id",
    "module_id",
    "module_version",
    "attempt",
    "capability",
    "replay_policy",
    "input_artifact_refs",
    "config_ref",
    "policy_ref",
    "authorization_refs",
    "budget",
    "deadline_at",
    "trace_context"
  ],
  "properties": {
    "schema_version": { "const": "demoops.execution_request.v1" },
    "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 },
    "workflow_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "workflow_template_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_version": { "$ref": "common.schema.json#/$defs/version" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
    "capability": { "$ref": "common.schema.json#/$defs/identifier" },
    "replay_policy": { "$ref": "common.schema.json#/$defs/replayPolicy" },
    "input_artifact_refs": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "config_ref": { "type": "string", "minLength": 3, "maxLength": 256 },
    "policy_ref": { "type": "string", "minLength": 3, "maxLength": 256 },
    "authorization_refs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/authorizationRef" }
    },
    "budget": { "$ref": "common.schema.json#/$defs/budget" },
    "deadline_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "trace_context": { "$ref": "common.schema.json#/$defs/traceContext" }
  },
  "allOf": [
    {
      "if": { "properties": { "replay_policy": { "const": "once_effect" } } },
      "then": { "properties": { "authorization_refs": { "type": "array", "minItems": 1 } } }
    }
  ]
}
