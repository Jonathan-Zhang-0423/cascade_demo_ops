{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-demoops.local/contracts/execution-port/v1/module-manifest.schema.json",
  "title": "DemoOps Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "module_version",
    "protocol_versions",
    "capabilities",
    "input_roles",
    "output_roles",
    "supported_replay_policies",
    "risk_classes",
    "required_permissions",
    "transports",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": "demoops.module_manifest.v1" },
    "module_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_version": { "$ref": "common.schema.json#/$defs/version" },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "demoops.execution_port.v1" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "input_roles": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/roleContract" }
    },
    "output_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/roleContract" }
    },
    "supported_replay_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/replayPolicy" }
    },
    "risk_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["read_only", "write_low", "write_high", "destructive", "provider_spend"] }
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["in_process", "jsonrpc_stdio", "http_sse"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_event_bytes", "max_input_artifacts", "max_output_artifacts"],
      "properties": {
        "max_event_bytes": { "const": 1048576 },
        "max_input_artifacts": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "max_output_artifacts": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    }
  },
  "$defs": {
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required", "max_data_class"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 96 },
        "required": { "type": "boolean" },
        "max_data_class": {
          "enum": ["public_config", "operational_metadata", "customer_business_data", "sensitive_artifact"]
        },
        "media_types": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 128 }
        }
      }
    }
  }
}
