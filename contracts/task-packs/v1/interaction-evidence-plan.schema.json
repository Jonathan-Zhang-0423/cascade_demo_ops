{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-demoops.local/contracts/task-packs/v1/interaction-evidence-plan.schema.json",
  "title": "DemoOps Interaction Evidence Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "surface_kind", "steps"],
  "properties": {
    "schema_version": { "const": "demoops.interaction_evidence_plan.v1" },
    "plan_id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
    "surface_kind": { "enum": ["dom", "iframe", "canvas", "runtime_discovered"] },
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "semantic_intent", "replay_policy", "preconditions", "expected_changes", "evidence_slots", "proof_requirements"],
        "properties": {
          "step_id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
          "semantic_intent": { "type": "string", "minLength": 3, "maxLength": 320 },
          "replay_policy": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/replayPolicy" },
          "preconditions": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 240 } },
          "expected_changes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "enum": ["dom", "aria", "url", "network", "visual", "frame", "interaction"] } },
          "evidence_slots": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 96 } },
          "proof_requirements": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["all_evidence_slots", "distinct_actions", "region_changed", "numeric_increase", "approximate_state_restore", "input_modality", "state_variants"] },
                "min_count": { "type": "integer", "minimum": 1, "maximum": 12 },
                "modality": { "enum": ["keyboard", "pointer", "touch"] },
                "min_similarity": { "type": "number", "minimum": 0.5, "maximum": 1 }
              }
            }
          },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 12 }
        }
      }
    }
  }
}
