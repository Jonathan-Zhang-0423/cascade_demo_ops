{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-demoops.local/contracts/task-packs/v1/experiment-run-report.schema.json",
  "title": "DemoOps Experiment Run Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "valid", "scores", "human_interventions", "model_consumption", "once_effect_records", "artifact_refs", "automation_attribution"],
  "properties": {
    "schema_version": { "const": "demoops.experiment_run_report.v1" },
    "run_id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
    "valid": { "type": "boolean" },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["orchestration", "product", "evidence", "film", "recovery"],
      "properties": {
        "orchestration": { "$ref": "#/$defs/score" }, "product": { "$ref": "#/$defs/score" },
        "evidence": { "$ref": "#/$defs/score" }, "film": { "$ref": "#/$defs/score" }, "recovery": { "$ref": "#/$defs/score" }
      }
    },
    "human_interventions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "required": ["kind", "allowed"], "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 3, "maxLength": 96 },
          "allowed": { "type": "boolean" },
          "occurred_at": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/timestamp" }
        }
      }
    },
    "model_consumption": { "type": "object", "required": ["visual_calls", "provider_calls"], "additionalProperties": false, "properties": { "visual_calls": { "type": "integer", "minimum": 0, "maximum": 24 }, "provider_calls": { "type": "integer", "minimum": 0, "maximum": 8 } } },
    "once_effect_records": { "type": "array", "maxItems": 16, "items": { "type": "object", "required": ["effect_id", "status"], "additionalProperties": false, "properties": { "effect_id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" }, "status": { "enum": ["not_started", "started", "confirmed", "uncertain"] }, "evidence_refs": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 3, "maxLength": 256 } } } } },
    "artifact_refs": { "type": "array", "maxItems": 256, "items": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/artifactRef" } },
    "failure_reasons": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
    "automation_attribution": { "type": "object", "additionalProperties": false, "required": ["out_of_band_browser_actions", "allowed_human_gates", "system_actions"], "properties": { "out_of_band_browser_actions": { "type": "integer", "minimum": 0 }, "allowed_human_gates": { "type": "integer", "minimum": 0, "maximum": 2 }, "system_actions": { "type": "integer", "minimum": 0 } } }
  },
  "$defs": { "score": { "type": "number", "minimum": 0, "maximum": 100 } }
}
