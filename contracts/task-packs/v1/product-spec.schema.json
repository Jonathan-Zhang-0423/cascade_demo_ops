{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-demoops.local/contracts/task-packs/v1/product-spec.schema.json",
  "title": "DemoOps Product Spec Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "title", "objective", "audience", "requirements", "visual_direction", "interaction_requirements", "observable_acceptance", "forbidden_outcomes"],
  "properties": {
    "schema_version": { "const": "demoops.product_spec_artifact.v1" },
    "spec_id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 10, "maxLength": 1200 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 240 },
    "build_brief": { "type": "string", "minLength": 10, "maxLength": 140, "pattern": "^[^\\r\\n]+$" },
    "requirements": {
      "type": "array", "minItems": 4, "maxItems": 32,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "visual_direction": {
      "type": "object", "additionalProperties": false,
      "required": ["theme", "palette", "motion"],
      "properties": {
        "theme": { "type": "string", "minLength": 3, "maxLength": 240 },
        "palette": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 48 } },
        "motion": { "type": "string", "minLength": 3, "maxLength": 240 }
      }
    },
    "interaction_requirements": {
      "type": "array", "minItems": 2, "maxItems": 24,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "responsive_requirements": {
      "type": "array", "maxItems": 16,
      "items": { "type": "string", "minLength": 3, "maxLength": 320 }
    },
    "observable_acceptance": {
      "type": "array", "minItems": 4, "maxItems": 32,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "forbidden_outcomes": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "string", "minLength": 3, "maxLength": 320 }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "priority"],
      "properties": {
        "id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 3, "maxLength": 500 },
        "priority": { "enum": ["must", "should"] }
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "evidence_kinds", "required"],
      "properties": {
        "id": { "$ref": "../../execution-port/v1/common.schema.json#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 3, "maxLength": 500 },
        "evidence_kinds": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": { "enum": ["dom", "aria", "url", "network", "visual", "frame", "interaction"] }
        },
        "required": { "type": "boolean" }
      }
    }
  }
}
