APP_MODE=desktop
NODE_WORKER_PATH=../video-worker/dist/index.js

# Model provider API keys. Leave blank unless the provider is enabled.
# Never commit real API keys; desktop/cloud runtime reads them from env or vault only.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
ARK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Default model routing. Override only when changing the planned provider/model split.
CASCADE_PLANNING_PROVIDER=kimi
CASCADE_PLANNING_MODEL=kimi-2.5
CASCADE_CODE_READING_PROVIDER=glm
CASCADE_CODE_READING_MODEL=glm-5.2
CASCADE_MULTIMODAL_PROVIDER=minimax
CASCADE_MULTIMODAL_MODEL=minimax-m3
CASCADE_VIDEO_PROVIDER=seedance
CASCADE_VIDEO_MODEL=seedance-2.0

DEMO_USER=xxx
DEMO_PASS=xxx
PRODUCT_URL=http://localhost:3000
GIT_REPO_URL=
LOCAL_REPO_PATH=
SSH_HOST=
SSH_PORT=22
SSH_USER=xxx
SSH_PRIVATE_KEY_SECRET_REF=
SSH_PASSWORD_SECRET_REF=
