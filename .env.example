APP_MODE=desktop
NODE_WORKER_PATH=../video-worker/dist/index.js
CASCADE_FFMPEG_PATH=ffmpeg
CASCADE_FFPROBE_PATH=ffprobe
VITE_CASCADE_BRIDGE=local
VITE_CASCADE_BRIDGE_URL=
# Doubao OpenSpeech Agent Plan TTS. Candidates remain review-only until
# explicitly confirmed and imported as narration_audio; they are never
# auto-mixed. VOLC_TTS_ACCESS_KEY may contain the Agent Plan key for existing
# local setups; VOLC_TTS_AGENT_PLAN_API_KEY is the explicit preferred name.
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_AGENT_PLAN_API_KEY=
VOLC_TTS_AGENT_PLAN_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=
DOUBAO_AUDIO_MODEL=seed-tts-2.0
CASCADE_TTS_OUTPUT_DIR=
CASCADE_TTS_POLL_ATTEMPTS=20
CASCADE_TTS_POLL_INTERVAL_MS=3000
CASCADE_TTS_DOWNLOAD_MAX_BYTES=67108864
CASCADE_TTS_PREFLIGHT_AUDIT_PATH=

# Model provider API keys. Leave blank unless the provider is enabled.
# Never commit real API keys; desktop/cloud runtime reads them from env or vault only.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=
# Dedicated passive H3 sidecar settings. The operator harness may reuse the
# generic key/base only when CASCADE_VIDEO_PROVIDER/MODEL explicitly select H3.
CASCADE_MINIMAX_H3_MODE=disabled
MINIMAX_H3_API_KEY=
MINIMAX_H3_BASE_URL=https://api.minimaxi.com
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
ARK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Default model routing. Override only when changing the planned provider/model split.
CASCADE_PLANNING_PROVIDER=kimi
CASCADE_PLANNING_MODEL=kimi-k2.7-code
CASCADE_CODE_READING_PROVIDER=glm
CASCADE_CODE_READING_MODEL=glm-5.2
CASCADE_MULTIMODAL_PROVIDER=minimax
CASCADE_MULTIMODAL_MODEL=minimax-m3
CASCADE_VIDEO_PROVIDER=minimax-h3
CASCADE_VIDEO_MODEL=minimax-h3

# Ark media generation remains dry-run until explicitly enabled.
CASCADE_ARK_MEDIA_MODE=dry_run
# FinalFilm Seedance 2.5 execution also requires this separate opt-in. It is
# independent from CASCADE_VIDEO_PROVIDER so H3 and Seedance can coexist.
CASCADE_SEEDANCE_FINAL_FILM_ENABLED=false
# Server-owned Seedance 2.5 admission. Defaults are the documented personal
# tier ceiling (3 concurrent / 180 task creates per minute); set these only
# after confirming the actual account and Endpoint quota. Never let App input
# control these values.
CASCADE_SEEDANCE25_MAX_CONCURRENT=3
CASCADE_SEEDANCE25_CREATE_TASK_RPM=180
CASCADE_SEEDANCE25_IDEMPOTENCY_TTL_SEC=86400
# Real Ark calls require provider-reachable HTTPS source media. The static
# publisher copies only selected captured artifacts to this directory; the
# base URL must be an externally reachable HTTPS origin for that directory.
CASCADE_ARK_ASSET_PUBLIC_DIR=
CASCADE_ARK_ASSET_PUBLIC_BASE_URL=
CASCADE_ARK_MEDIA_POLL_ATTEMPTS=1
CASCADE_ARK_MEDIA_POLL_INTERVAL_MS=3000
# Keep generated candidate downloads bounded during the first real test.
CASCADE_ARK_MEDIA_DOWNLOAD_MAX_BYTES=536870912

# Private TOS publishing for real Ark media tests. Set locally only; the Server
# uploads selected captured artifacts and gives Ark short-lived signed GET URLs.
VOLC_TOS_ACCESS_KEY=
VOLC_TOS_SECRET_KEY=
VOLC_TOS_ENDPOINT=tos-cn-beijing.volces.com
# SDK upload endpoint. Keep separate from VOLC_TOS_ENDPOINT when Ark requires
# an ivolces.com private presigned URL for model input.
VOLC_TOS_API_ENDPOINT=tos-cn-beijing.volces.com
VOLC_TOS_REGION=cn-beijing
VOLC_TOS_BUCKET=
VOLC_TOS_PREFIX=ark-media/
VOLC_TOS_SIGNED_URL_TTL_SEC=3600

# Direct API v1 local Gateway. Generate local-only TLS files with
# `go run ./backend/cmd/directcert` and keep the actual 32+ character tokens
# in ignored .env or a secret manager. The Server preflight records only
# presence and certificate validity, never these values.
CASCADE_DIRECT_PUBLIC_HOST=localhost:18443
CASCADE_DIRECT_BOOTSTRAP_TOKEN=
CASCADE_DIRECT_WORKER_TOKEN=
CASCADE_DIRECT_TLS_CERT=
CASCADE_DIRECT_TLS_KEY=
CASCADE_DIRECT_STATE_PATH=

DEMO_USER=xxx
DEMO_PASS=xxx
PRODUCT_URL=http://localhost:3000
GIT_REPO_URL=
LOCAL_REPO_PATH=
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Local bootstrap only. A real value belongs in ignored .env, never here.
# Prefer SSH_PASSWORD for this one-time public-key bootstrap, or set
# SSH_PASSWORD_SECRET_REF=env:LOCAL_SSH_PASSWORD to resolve another local env var.
SSH_PASSWORD=
SSH_PRIVATE_KEY_SECRET_REF=
SSH_PASSWORD_SECRET_REF=
# Compatibility aliases accepted by scripts/bootstrap-real-ubuntu.ps1:
# server address: 203.0.113.10
# server username: ubuntu
# server password: local-only-secret
