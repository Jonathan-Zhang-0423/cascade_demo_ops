[Unit]
Description=Cascade Browser Agent Direct Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cascade-browser-gateway
Group=cascade-browser-gateway
EnvironmentFile=/etc/cascade-browser-agent/gateway.env
ExecStart=/usr/local/bin/cascade-browser-agent-gateway
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/cascade-browser-agent/gateway
ReadOnlyPaths=/etc/cascade-browser-agent

[Install]
WantedBy=multi-user.target
