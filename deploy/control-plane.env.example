CASCADE_PROFILE=cloud
APP_ENV=staging
APP_MODE=web
DATABASE_DIALECT=sqlite
CASCADE_DATA_ROOT=/var/lib/demoops/data
SQLITE_PATH=/var/lib/demoops/data/demoops.db
CASCADE_ARTIFACT_ROOT=/var/lib/demoops/artifacts
CASCADE_CACHE_ROOT=/var/lib/demoops/cache
CASCADE_LOG_ROOT=/var/log/demoops
NODE_BINARY_PATH=/usr/bin/node
NODE_WORKER_PATH=/opt/demoops/current/video-worker/dist/index.js
CASCADE_FFMPEG_PATH=/usr/bin/ffmpeg
CASCADE_FFPROBE_PATH=/usr/bin/ffprobe
PLAYWRIGHT_BROWSERS_PATH=/var/lib/demoops/playwright
CASCADE_LLM_MODE=real
CASCADE_ARK_MEDIA_MODE=dry_run

# Provider credentials are deployment secrets. Set only required keys in the
# real /etc/demoops/control-plane.env file and keep it mode 0600.
# GLM_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# SEEDANCE_API_KEY=
